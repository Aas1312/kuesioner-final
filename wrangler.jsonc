{
  // Nama ini HARUS persis "kpma" supaya deploy menimpa worker yang sudah
  // ada (URL kpma.posisimasyarakatadat.workers.dev tetap sama), bukan
  // bikin worker baru.
  "name": "kpma",
  "main": "worker.js",
  "compatibility_date": "2026-11-03",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kuesioner-db",
      // Ganti dengan Database ID asli: Workers & Pages > D1 > kuesioner-db
      // > halaman overview-nya, ada tulisan "Database ID".
      "database_id": "802365d9-9333-4933-8f0c-a59dc2c8a6ba"
    }
  ]
}
